<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.hikari.rent.dashboard.mapper.DashboardMapper">

  <resultMap
    id="DashboardStatsResultMap"
    type="com.hikari.rent.dashboard.repository.model.DashboardStatsRow">

    <result column="user_count" property="userCount"/>
    <result column="company_count" property="companyCount"/>
    <result column="rental_count" property="rentalCount"/>

    <result
      column="pending_review_count"
      property="pendingReviewCount"/>

    <result column="published_count" property="publishedCount"/>
    <result column="rented_count" property="rentedCount"/>

  </resultMap>

  <select
    id="selectRentalStats"
    resultMap="DashboardStatsResultMap">

    SELECT
    COUNT(*) AS rental_count,

    COALESCE(
    SUM(CASE WHEN r.review_status = 1 THEN 1 ELSE 0 END),
    0
    ) AS pending_review_count,

    COALESCE(
    SUM(CASE WHEN r.status = 1 THEN 1 ELSE 0 END),
    0
    ) AS published_count,

    COALESCE(
    SUM(CASE WHEN r.status = 2 THEN 1 ELSE 0 END),
    0
    ) AS rented_count

    FROM rentals r

    WHERE 1 = 1

    <choose>
      <when test="scope != null
                  and scope.userId != null
                  and scope.platform">
        AND 1 = 1
      </when>

      <when test="scope != null
                  and scope.userId != null
                  and scope.companyId != null
                  and (scope.company or scope.self)">

        AND r.company_id = #{scope.companyId}

        <if test="scope.self">
          AND r.agent_id = #{scope.userId}
        </if>
      </when>

      <otherwise>
        AND 1 = 0
      </otherwise>
    </choose>
  </select>

  <!-- Platform-only totals include active and disabled records. -->
  <select
    id="selectPlatformStats"
    resultMap="DashboardStatsResultMap">

    SELECT
    (SELECT COUNT(*) FROM users) AS user_count,
    (SELECT COUNT(*) FROM companies) AS company_count
  </select>

  <!-- Count all accounts belonging to the company. -->
  <select id="countCompanyEmployees" resultType="long">
    SELECT COUNT(*)
    FROM users
    WHERE company_id = #{companyId}
  </select>

</mapper>
