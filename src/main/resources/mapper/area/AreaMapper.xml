<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.hikari.rent.area.mapper.AreaMapper">

  <select
    id="selectPopularityAreasByCodes"
    resultType="com.hikari.rent.area.repository.model.AreaPopularityRow">

    SELECT
    code,
    name

    FROM areas

    WHERE level = 3

    <choose>
      <when test="codes != null and codes.size() > 0">
        AND code IN
        <foreach
          collection="codes"
          item="code"
          open="("
          separator=","
          close=")">
          #{code}
        </foreach>
      </when>

      <otherwise>
        AND 1 = 0
      </otherwise>
    </choose>

  </select>

</mapper>
