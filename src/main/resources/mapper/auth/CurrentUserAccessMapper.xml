<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.hikari.rent.auth.mapper.CurrentUserAccessMapper">

  <resultMap
    id="CurrentUserRoleResultMap"
    type="com.hikari.rent.auth.repository.model.CurrentUserRoleRow">

    <result column="user_id" property="userId"/>
    <result column="company_id" property="companyId"/>
    <result column="company_status" property="companyStatus"/>
    <result column="role_code" property="roleCode"/>
    <result column="role_scope" property="roleScope"/>

  </resultMap>


  <!-- Preserve active users even when no active role is assigned. -->
  <select
    id="selectUserRoles"
    resultMap="CurrentUserRoleResultMap">

    SELECT
    u.id AS user_id,
    u.company_id,
    c.status AS company_status,
    r.code AS role_code,
    r.scope AS role_scope

    FROM users u

    LEFT JOIN companies c
    ON c.id = u.company_id

    LEFT JOIN user_roles ur
    ON ur.user_id = u.id

    LEFT JOIN roles r
    ON r.id = ur.role_id
    AND r.status = 1

    WHERE u.id = #{userId}
    AND u.status = 1

    ORDER BY r.id

  </select>

</mapper>
