<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.hikari.rent.user.mapper.BrowsingHistoryMapper">

  <resultMap
    id="BrowsingHistoryResultMap"
    type="com.hikari.rent.user.repository.model.BrowsingHistoryRow">

    <id column="rental_id" property="rentalId"/>

    <result
      column="last_viewed_at"
      property="lastViewedAt"/>
  </resultMap>

  <!-- Load the latest history for cache recovery. -->
  <select
    id="selectRecent"
    resultMap="BrowsingHistoryResultMap">

    SELECT
    rental_id,
    last_viewed_at

    FROM browsing_history

    WHERE user_id = #{userId}

    ORDER BY
    last_viewed_at DESC,
    rental_id DESC

    LIMIT 30
  </select>

  <!-- Remove the previous snapshot for one user only. -->
  <delete id="deleteByUserId">

    DELETE FROM browsing_history

    WHERE user_id = #{userId}
  </delete>

  <!-- Persist the original browsing timestamps from Redis. -->
  <insert id="insertBatch">

    INSERT INTO browsing_history (
    user_id,
    rental_id,
    last_viewed_at
    )

    VALUES

    <foreach
      collection="records"
      item="record"
      separator=",">

      (
      #{userId},
      #{record.rentalId},
      #{record.lastViewedAt}
      )

    </foreach>
  </insert>

</mapper>
