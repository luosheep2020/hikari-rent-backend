<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.hikari.rent.user.mapper.UserProfileMapper">

  <resultMap
    id="UserProfileResultMap"
    type="com.hikari.rent.user.repository.model.UserProfileRow">

    <id
      column="id"
      property="id"/>

    <result
      column="nickname"
      property="nickname"/>

    <result
      column="avatar_file_id"
      property="avatarFileId"/>

    <result
      column="avatar_storage_key"
      property="avatarStorageKey"/>

  </resultMap>

  <!-- Return only a valid avatar owned by the user. -->
  <select
    id="selectProfile"
    resultMap="UserProfileResultMap">

    SELECT
    u.id,
    u.nickname,
    f.id AS avatar_file_id,
    f.storage_key AS avatar_storage_key

    FROM users u

    LEFT JOIN files f
    ON f.id = u.avatar_file_id
    AND f.owner_id = u.id
    AND f.purpose = 'AVATAR'
    AND f.status = 1

    WHERE u.id = #{userId}
    AND u.status = 1

  </select>

  <!-- Keep the validated file stable until the transaction ends. -->
  <select
    id="selectOwnedAvatarForShare"
    resultType="java.lang.Long">

    SELECT id
    FROM files
    WHERE id = #{fileId}
    AND owner_id = #{userId}
    AND purpose = 'AVATAR'
    AND status = 1
    FOR SHARE

  </select>

  <!-- Omitted fields remain unchanged. -->
  <update id="updateProfile">

    UPDATE users

    <set>
      <if test="nickname != null">
        nickname = #{nickname},
      </if>

      <choose>
        <when test="removeAvatar">
          avatar_file_id = NULL,
        </when>

        <when test="avatarFileId != null">
          avatar_file_id = #{avatarFileId},
        </when>
      </choose>

      updated_at = UTC_TIMESTAMP(3)
    </set>

    WHERE id = #{userId}
    AND status = 1

  </update>

</mapper>
