<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.hikari.rent.user.mapper.UserMapper">

  <resultMap
    id="UserResultMap"
    type="com.hikari.rent.user.entity.User">

    <id column="id" property="id"/>

    <result column="email" property="email"/>
    <result column="nickname" property="nickname"/>
    <result column="avatar_file_id" property="avatarFileId"/>
    <result column="phone" property="phone"/>

    <result column="company_id" property="companyId"/>
    <result column="department_id" property="departmentId"/>
    <result column="position_id" property="positionId"/>

    <result column="status" property="status"/>

    <result
      column="email_verified_at"
      property="emailVerifiedAt"/>

    <result
      column="last_login_at"
      property="lastLoginAt"/>

    <result
      column="password_changed_at"
      property="passwordChangedAt"/>

    <result column="created_at" property="createdAt"/>
    <result column="updated_at" property="updatedAt"/>

  </resultMap>

  <!-- Load account information without password credentials. -->
  <select id="selectUserById" resultMap="UserResultMap">
    SELECT
    id,
    email,
    nickname,
    avatar_file_id,
    phone,
    company_id,
    department_id,
    position_id,
    status,
    email_verified_at,
    last_login_at,
    password_changed_at,
    created_at,
    updated_at

    FROM users

    WHERE id = #{id}
  </select>

</mapper>
